# Zentra Backend Configuration

# Environment
APP_ENV=development

# Server Configuration
PORT=8080
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Captcha Configuration (Cloudflare Turnstile)
CAPTCHA_ENABLED=true
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Email Verification Configuration
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@zentra.local
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_TOKEN_TTL=24h

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=zentra
POSTGRES_PASSWORD=zentra_secure_password
POSTGRES_DB=zentra
POSTGRES_SSLMODE=disable
# Alternative: Use DATABASE_URL directly (overrides individual settings)
# DATABASE_URL=postgres://zentra:zentra_secure_password@localhost:5432/zentra?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# Alternative: Use REDIS_URL directly (overrides individual settings)
# REDIS_URL=redis://localhost:6379

# MinIO/Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=zentra_minio
MINIO_SECRET_KEY=zentra_minio_secret
MINIO_USE_SSL=false
MINIO_BUCKET_ATTACHMENTS=attachments
CDN_BASE_URL=http://localhost:9000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=2160h

# Encryption Configuration
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# GitHub API (optional, recommended for higher rate limits)
GITHUB_TOKEN=

# Update Configuration (for the admin server management panel)
#
# UPDATE_METHOD controls how the "Update Backend/Frontend/All" buttons work:
#   docker  - Pull latest code via git, run database migrations, and rebuild the api service via the Docker socket.
#   command - Execute the shell command from UPDATE_COMMAND.
#   direct  - Run git pull and build directly on the server (requires git, go, pnpm/npm installed on the host).
#
# For custom update scripts: UPDATE_COMMAND is the shell command to run. The target ("backend", "frontend", or "all") is passed as the UPDATE_TARGET environment variable.

UPDATE_METHOD=docker
# UPDATE_COMMAND=

# Docker group GID on the host (needed for the admin update panel to access the Docker socket).
# Find it with: getent group docker | cut -d: -f3
# DOCKER_GID=999

BACKEND_DIR=/app
FRONTEND_DIR=/frontend